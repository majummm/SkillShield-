# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA suba o arquivo ".env" (com a chave de verdade) para um repositorio publico.

# Chave de API do Google Gemini — crie gratuitamente em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modelo do Gemini a usar (opcional; padrao: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Porta em que o servidor Flask vai rodar (opcional; padrao: 5000)
PORT=5000
